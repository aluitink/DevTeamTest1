# =============================================================================
# .env.example — required and optional environment variables for DevTeamTest1
# =============================================================================
# Copy this file to `.env` and fill in real values for your environment.
# Never commit a real `.env` file or its secrets to the repository.
#
# Usage (bash / zsh):
#   set -a; . ./.env; set +a; dotnet run --project hello
#
# Each variable is documented in the "Environment variables" section of
# README.md.

# --- .NET runtime (optional; sensible defaults are already baked in) ---------
# Suppress the .NET copyright/logo banner in console output.
DOTNET_NOLOGO=1
# Opt out of .NET CLI usage telemetry.
DOTNET_CLI_TELEMETRY_OPTOUT=1
# Skip the .NET first-time experience prompts.
DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

# --- NuGet / package management ----------------------------------------------
# Location of the global NuGet package cache.
# Keep in sync with NuGet.Config (`globalPackagesFolder`).
NUGET_PACKAGES=/workspace/nuget/packages
# Skip XML documentation file generation for faster builds.
NUGET_XMLDOC_MODE=skip

# --- Application configuration (optional) ------------------------------------
# Default greeting used when `hello` is run without a command-line argument.
# Currently informational: `hello/Program.cs` falls back to "World" and the
# variable is not yet read by the code.
GREETING_DEFAULT_NAME=World
