<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Reference the compiled console app so its output assembly (hello.dll)
         is built and copied next to the test assembly for the integration tests. -->
    <ProjectReference Include="..\hello\hello.csproj" />
    <!-- The integration tests launch "dotnet hello.dll"; make sure the app's
         project dependency (Greeter.dll) is copied to the test output directory
         as well, so the spawned process can resolve all of its dependencies. -->
    <ProjectReference Include="..\Greeter\Greeter.csproj">
      <Private>true</Private>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

</Project>
