{
  "name": "@devteamtest1/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Centralized Zod validation schemas for API inputs and outputs (task #72).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./items": {
      "types": "./dist/resources/items/index.d.ts",
      "import": "./dist/resources/items/index.js",
      "default": "./dist/resources/items/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
